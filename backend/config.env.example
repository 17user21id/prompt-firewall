# Prompt Firewall Backend Configuration

# Environment variables
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GOOGLE_CLOUD_PROJECT=your-project-id
FIRESTORE_DATABASE=your-database-name

# OpenAI Configuration (optional)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Encryption Configuration
ENCRYPTION_KEY=your-encryption-key-base64-encoded

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_FILE_SIZE=10485760  # 10MB in bytes
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(filename)s:%(lineno)d | %(funcName)s | %(message)s

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_WINDOW_MINUTES=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
CORS_ORIGINS=["http://localhost:3000", "https://your-frontend-domain.com"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "your-api-domain.com"]

# Database
FIRESTORE_EMULATOR_HOST=localhost:8080  # For local development
FIRESTORE_EMULATOR_PROJECT_ID=test-project

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Feature Flags
ENABLE_OPENAI_DETECTION=false
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_METRICS_COLLECTION=true
